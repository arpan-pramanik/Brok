{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "http://YOUR_AWS_ORCHESTRATOR_IP:8000/api/:path*"
    },
    {
      "source": "/ws",
      "destination": "http://YOUR_AWS_ORCHESTRATOR_IP:8000/ws"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400, stale-while-revalidate=60"
        }
      ]
    }
  ]
}
